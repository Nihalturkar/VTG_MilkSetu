NODE_ENV=development
PORT=4000
# Serve the built admin panel from this same process (one service, one URL).
# Defaults to true in production, false in development.
SERVE_ADMIN=false
MONGODB_URI=mongodb://127.0.0.1:27017/vtgmilksetu
# Only needed when MONGODB_URI has no database in its path (typical for Atlas
# strings that stop at the host). Leave blank if the URI already ends in /<db>.
# Note: the db name goes BEFORE the "?", e.g. .../Dairy?retryWrites=true
DB_NAME=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_secret
SESSION_TTL_DAYS=180
ADMIN_TOKEN_TTL_HOURS=12
# Comma-separated list, no trailing slash
CORS_ORIGINS=http://localhost:3000
# Used only by `npm run seed:admin`
SEED_ADMIN_EMAIL=admin@vtgmilksetu.local
SEED_ADMIN_PASSWORD=
